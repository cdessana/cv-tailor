{
  "name": "cv-tailor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "echo 'Build completed successfully'",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.mjs",
    "test:llm": "node --test test/llm-adapter.test.mjs",
    "test:schemas": "node --test tests/job-schemas.test.mjs",
    "test:preprocess": "node --test tests/job-preprocess.test.mjs",
    "test:parser-aliases": "node --test tests/parser-aliases.test.mjs",
    "test:extraction": "node --test tests/job-extraction.test.mjs",
    "test:semantic-extraction": "node --test tests/job-semantic-extract.test.mjs",
    "test:evidence": "node --test tests/job-evidence.test.mjs",
    "test:map-job": "node --test tests/job-map.test.mjs",
    "test:job-parser": "node --test tests/job-parser-cli.test.mjs",
    "test:job-parser-e2e": "node --test tests/job-parser-e2e.test.mjs",
    "test:gemini-provider": "node --test tests/gemini-provider.test.mjs",
    "test:job-parser-providers": "node --test tests/job-parser-providers.test.mjs",
    "test:ollama-provider": "node --test tests/ollama-provider.test.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "validate": "node scripts/validate.mjs data/resumes/base.json",
    "base:html": "resumed render data/resumes/base.json --theme jsonresume-theme-stackoverflow --output output/resume.html",
    "base:pdf": "node scripts/render.mjs data/resumes/base.json --output-dir output",
    "flash:html": "resumed render output/flash/resume.json --theme jsonresume-theme-stackoverflow --output output/flash/resume.html",
    "flash:pdf": "node scripts/render.mjs output/flash/resume.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "resume-cli": "^3.7.2",
    "resumed": "^6.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/generative-ai": "^0.24.1",
    "express": "^5.2.1",
    "jsonresume-theme-modern-plain": "^1.4.6",
    "jsonresume-theme-stackoverflow": "^3.3.0",
    "ollama": "^0.6.3",
    "openai": "^7.10.0",
    "zod": "^4.5.4"
  }
}
