{
  "name": "cv-tailor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "test:llm": "node --test test/llm-adapter.test.mjs",
    "test:schemas": "node --test tests/job-schemas.test.mjs",
    "test:preprocess": "node --test tests/job-preprocess.test.mjs",
    "test:parser-aliases": "node --test tests/parser-aliases.test.mjs",
    "test:extraction": "node --test tests/job-extraction.test.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "validate": "node scripts/validate.mjs data/resumes/base.json",
    "base:html": "resumed render data/resumes/base.json --theme jsonresume-theme-stackoverflow --output output/resume.html",
    "base:pdf": "npm run base:html && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=output/resume.pdf \"file://$(pwd)/output/resume.html\"",
    "flash:html": "resumed render output/flash/resume.json --theme jsonresume-theme-stackoverflow --output output/flash/resume.html",
    "flash:pdf": "npm run flash:html && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=output/flash/resume.pdf \"file://$(pwd)/output/flash/resume.html\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "resume-cli": "^3.7.2",
    "resumed": "^6.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/generative-ai": "^0.24.1",
    "jsonresume-theme-stackoverflow": "^3.3.0",
    "ollama": "^0.6.3",
    "openai": "^7.10.0",
    "zod": "^4.5.4"
  }
}
