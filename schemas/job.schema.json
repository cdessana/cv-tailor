{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline-compatible job output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company": {
      "$ref": "#/definitions/text"
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "type": {
      "$ref": "#/definitions/text"
    },
    "remote": {
      "$ref": "#/definitions/text"
    },
    "location": {
      "$ref": "#/definitions/text"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/definitions/text"
        },
        "url": {
          "$ref": "#/definitions/text"
        },
        "applicationUrl": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "description": {
      "$ref": "#/definitions/text"
    },
    "responsibilities": {
      "$ref": "#/definitions/strings"
    },
    "qualifications": {
      "$ref": "#/definitions/strings"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/definitions/text"
          },
          "keywords": {
            "$ref": "#/definitions/strings"
          }
        },
        "required": [
          "name",
          "keywords"
        ]
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/definitions/strings"
        },
        "preferred": {
          "$ref": "#/definitions/strings"
        },
        "competencies": {
          "$ref": "#/definitions/strings"
        }
      }
    },
    "requirementExamples": {
      "description": "Illustrations linked to a final requirement; these do not participate in matching as mandatory choices.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "requirement", "values"],
        "properties": {
          "classification": { "enum": ["required", "preferred", "competencies"] },
          "requirement": { "$ref": "#/definitions/text" },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/text" }
          }
        }
      }
    },
    "screening": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "$ref": "#/definitions/text"
          },
          "type": {
            "$ref": "#/definitions/text"
          },
          "keywords": {
            "$ref": "#/definitions/strings"
          }
        },
        "required": [
          "topic",
          "type"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/definitions/text"
        },
        "status": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "alternativeRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operator",
          "classification",
          "kind",
          "values",
          "context"
        ],
        "properties": {
          "operator": {
            "const": "anyOf"
          },
          "classification": {
            "enum": [
              "required",
              "preferred"
            ]
          },
          "kind": {
            "enum": [
              "skill",
              "requirement",
              "competency"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/text"
            }
          },
          "context": {
            "$ref": "#/definitions/text"
          }
        }
      }
    }
  },
  "required": [
    "company",
    "title"
  ],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      }
    }
  }
}
